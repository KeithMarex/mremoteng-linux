<Project Sdk="Microsoft.NET.Sdk">
  <!-- A VNC (RFB) client without a UI, for mRemoteNG for Linux: protocol, authentication (VNC and Apple Remote
       Desktop) and encodings, drawing into a framebuffer the app shows. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>mRemoteNG.Vnc</RootNamespace>
    <AssemblyName>mRemoteNG.Vnc</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release;Release Self-Contained;Deploy to github</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="mRemoteNG.Vnc.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- MIT. Single DES (VNC authentication) is not in OpenSSL 3's default provider, which .NET uses on Linux. -->
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
</Project>
