<Project Sdk="Microsoft.NET.Sdk">
  <!-- Platform-neutral core shared by the Windows (WinForms) and Linux (Avalonia) apps. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>mRemoteNG</RootNamespace>
    <AssemblyName>mRemoteNG.Core</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <!-- Same suppressions as mRemoteNG.csproj for the moved code: nullable annotations, obsolete Rfc2898DeriveBytes ctor. -->
    <NoWarn>$(NoWarn);CS8632;SYSLIB0060</NoWarn>
    <Configurations>Debug;Release;Release Self-Contained;Deploy to github</Configurations>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- Calling a Windows-only API from Core is a build error, not a warning. -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="mRemoteNG.Core.Tests" />
    <!-- Code moved out of mRemoteNG keeps the internal access it had there (e.g. ConnectionInfo.Parent's
         setter, ReplacePluginProperties used by the deserializers that have not moved yet). -->
    <InternalsVisibleTo Include="mRemoteNG" />
    <InternalsVisibleTo Include="mRemoteNGTests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Language\Language.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Language.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <!-- Public so the WinForms app, the Linux app and plugins can share the translations. -->
    <EmbeddedResource Update="Language\Language.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <CustomToolNamespace>mRemoteNG.Resources.Language</CustomToolNamespace>
      <LastGenOutput>Language.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
