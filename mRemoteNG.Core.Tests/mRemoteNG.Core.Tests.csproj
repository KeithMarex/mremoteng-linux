<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>mRemoteNG.Core.Tests</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <Configurations>Debug;Release;Release Self-Contained;Deploy to github</Configurations>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\mRemoteNG.Core\mRemoteNG.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Portable helpers shared with mRemoteNGTests; linked so they keep one source. -->
    <Compile Include="..\mRemoteNGTests\TestHelpers\ConnectionInfoAllConnectionPropertiesEqualityComparer.cs" Link="TestHelpers\ConnectionInfoAllConnectionPropertiesEqualityComparer.cs" />
    <Compile Include="..\mRemoteNGTests\TestHelpers\ConnectionInfoHelpers.cs" Link="TestHelpers\ConnectionInfoHelpers.cs" />
    <Compile Include="..\mRemoteNGTests\TestHelpers\ConnectionInheritanceAllPropertiesEqualityComparer.cs" Link="TestHelpers\ConnectionInheritanceAllPropertiesEqualityComparer.cs" />
    <Compile Include="..\mRemoteNGTests\TestHelpers\Randomizer.cs" Link="TestHelpers\Randomizer.cs" />
    <Compile Include="..\mRemoteNGTests\TestHelpers\SerializableConnectionInfoAllPropertiesOfType.cs" Link="TestHelpers\SerializableConnectionInfoAllPropertiesOfType.cs" />
  </ItemGroup>
</Project>
