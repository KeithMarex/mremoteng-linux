<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="mRemoteNG.Avalonia.App"
             RequestedThemeVariant="Default">
    <!-- "Default" follows the desktop's light/dark preference. -->
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
