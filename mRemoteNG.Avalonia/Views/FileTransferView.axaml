<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:mRemoteNG.Avalonia"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.FileTransferView"
             x:DataType="vm:FileTransferViewModel">
    <UserControl.Resources>
        <StreamGeometry x:Key="FolderIcon">M1,3 L6,3 L8,5 L15,5 L15,14 L1,14 Z</StreamGeometry>
        <StreamGeometry x:Key="FileIcon">M3,1 L10,1 L13,4 L13,15 L3,15 Z</StreamGeometry>
        <!-- A row: the cells are as wide as the pane's columns (the list's Tag), which the user drags in the header. -->
        <DataTemplate x:Key="EntryTemplate" x:DataType="vm:FileEntryViewModel">
            <StackPanel Orientation="Horizontal">
                <DockPanel Width="{Binding $parent[ListBox].((vm:FilePaneViewModel)Tag).NameColumn.Width}">
                    <Panel Width="20">
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                              Data="{StaticResource FileIcon}" IsVisible="{Binding !IsDirectory}" />
                        <Path Width="14" Height="14" Stretch="Uniform" Fill="Goldenrod"
                              Data="{StaticResource FolderIcon}" IsVisible="{Binding IsDirectory}" />
                    </Panel>
                    <TextBlock Classes="cell" Text="{Binding Name}" Padding="0,0,4,0" />
                </DockPanel>
                <TextBlock Classes="cell" Width="{Binding $parent[ListBox].((vm:FilePaneViewModel)Tag).SizeColumn.Width}"
                           Text="{Binding SizeText}" TextAlignment="Right" Opacity="0.7" />
                <TextBlock Classes="cell" Width="{Binding $parent[ListBox].((vm:FilePaneViewModel)Tag).ModifiedColumn.Width}"
                           Text="{Binding ModifiedText}" Opacity="0.7" />
                <TextBlock Classes="cell" Width="{Binding $parent[ListBox].((vm:FilePaneViewModel)Tag).PermissionsColumn.Width}"
                           Text="{Binding Permissions}" FontFamily="monospace" Opacity="0.7" />
            </StackPanel>
        </DataTemplate>
        <!-- A column header: click to sort by the column (again for the other way round), drag its right edge to resize it. -->
        <DataTemplate x:Key="ColumnHeaderTemplate" x:DataType="vm:FileColumnViewModel">
            <Panel Width="{Binding Width}">
                <Button Classes="columnHeader" Command="{Binding SortCommand}" Focusable="False">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding SortMark}" FontSize="9" Opacity="0.7" Margin="4,0,0,0"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Header}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
                <Border Classes="columnGrip" Cursor="SizeWestEast" />
            </Panel>
        </DataTemplate>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="ListBox.files ListBoxItem">
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <!-- The directory a drop goes into -->
        <Style Selector="ListBox.files ListBoxItem.dropTarget /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MrHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MrHoverBorder}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="ListBox.files TextBlock.cell">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Column headers as in a Windows details list: flat, with a line between the columns and under the header. -->
        <Style Selector="Border.columnHeaders">
            <Setter Property="BorderBrush" Value="{DynamicResource MrPanelBorder}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Button.columnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource MrPanelBorder}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.columnHeader:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.columnHeader:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MrHover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MrPanelBorder}" />
        </Style>
        <Style Selector="Button.columnHeader:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Border.columnGrip">
            <Setter Property="Width" Value="6" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.paneTitle">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="4,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <!-- Status -->
        <DockPanel DockPanel.Dock="Bottom" Margin="8,2">
            <Button DockPanel.Dock="Right" Content="{x:Static app:UiText.Reconnect}" Command="{Binding ReconnectCommand}"
                    IsVisible="{Binding HasEnded}" Margin="8,2,0,2" />
            <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Opacity="0.7" Classes.warning="{Binding IsUnencrypted}">
                <TextBlock.Styles>
                    <Style Selector="TextBlock.warning">
                        <Setter Property="Foreground" Value="#C0392B" />
                        <Setter Property="Opacity" Value="1" />
                    </Style>
                </TextBlock.Styles>
            </TextBlock>
        </DockPanel>

        <!-- Transfers -->
        <Border DockPanel.Dock="Bottom" Height="150" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top">
                    <Button DockPanel.Dock="Right" Content="{x:Static app:UiText.ClearFinished}" Command="{Binding ClearFinishedCommand}" Margin="4" />
                    <TextBlock Classes="paneTitle" Text="{x:Static app:UiText.Transfers}" VerticalAlignment="Center" />
                </DockPanel>
                <ListBox Classes="files" ItemsSource="{Binding Transfers}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TransferItemViewModel">
                            <Grid ColumnDefinitions="20,*,160,2*,Auto" ToolTip.Tip="{Binding Route}">
                                <TextBlock Text="{Binding DirectionText}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <ProgressBar Grid.Column="2" Value="{Binding Percent}" Minimum="0" Maximum="100" Margin="8,0" VerticalAlignment="Center"
                                             MinWidth="0" Width="144" />
                                <TextBlock Grid.Column="3" Text="{Binding StateText}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           Opacity="0.8" />
                                <Button Grid.Column="4" Content="{x:Static app:UiText.Cancel}" Command="{Binding CancelCommand}"
                                        IsVisible="{Binding !IsFinished}" Padding="6,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="*,Auto,*">
            <!-- This computer -->
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="{x:Static app:UiText.ThisComputer}" />
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                    <Button DockPanel.Dock="Right" Content="⟳" ToolTip.Tip="{x:Static app:UiText.Refresh}" Command="{Binding Local.ReloadCommand}" />
                    <Button DockPanel.Dock="Right" Content="↑" ToolTip.Tip="{x:Static app:UiText.Up}" Command="{Binding Local.UpCommand}" Margin="4,0" />
                    <TextBox Text="{Binding Local.PathText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Local.GoToPathCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </DockPanel>
                <Border DockPanel.Dock="Top" Classes="columnHeaders">
                    <ScrollViewer x:Name="LocalHeader" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <!-- Lined up with the rows: the list items' padding on both sides. -->
                        <ItemsControl ItemsSource="{Binding Local.Columns}" ItemTemplate="{StaticResource ColumnHeaderTemplate}" Margin="6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <ListBox x:Name="LocalList" Classes="files" ItemsSource="{Binding Local.Entries}" SelectionMode="Multiple"
                         SelectedItems="{Binding Local.SelectedEntries}" ItemTemplate="{StaticResource EntryTemplate}"
                         Tag="{Binding Local}" ScrollViewer.HorizontalScrollBarVisibility="Auto" DragDrop.AllowDrop="True">
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding Local.OpenCommand}" CommandParameter="{Binding #LocalList.SelectedItem}" />
                        <KeyBinding Gesture="Back" Command="{Binding Local.UpCommand}" />
                    </ListBox.KeyBindings>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static app:UiText.Upload}" Command="{Binding UploadCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static app:UiText.Refresh}" Command="{Binding Local.ReloadCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="8" Margin="6,0">
                <Button Content="→" ToolTip.Tip="{x:Static app:UiText.Upload}" Command="{Binding UploadCommand}" />
                <Button Content="←" ToolTip.Tip="{x:Static app:UiText.Download}" Command="{Binding DownloadCommand}" />
            </StackPanel>

            <!-- The server -->
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Classes="paneTitle" Text="{Binding ServerDescription}" />
                <DockPanel DockPanel.Dock="Top" Margin="4,0,4,4">
                    <Button DockPanel.Dock="Right" Content="⟳" ToolTip.Tip="{x:Static app:UiText.Refresh}" Command="{Binding Remote.ReloadCommand}" />
                    <Button DockPanel.Dock="Right" Content="↑" ToolTip.Tip="{x:Static app:UiText.Up}" Command="{Binding Remote.UpCommand}" Margin="4,0" />
                    <TextBox Text="{Binding Remote.PathText}">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding Remote.GoToPathCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>
                </DockPanel>
                <Border DockPanel.Dock="Top" Classes="columnHeaders">
                    <ScrollViewer x:Name="RemoteHeader" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <!-- Lined up with the rows: the list items' padding on both sides. -->
                        <ItemsControl ItemsSource="{Binding Remote.Columns}" ItemTemplate="{StaticResource ColumnHeaderTemplate}" Margin="6,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
                <ListBox x:Name="RemoteList" Classes="files" ItemsSource="{Binding Remote.Entries}" SelectionMode="Multiple"
                         SelectedItems="{Binding Remote.SelectedEntries}" ItemTemplate="{StaticResource EntryTemplate}"
                         Tag="{Binding Remote}" ScrollViewer.HorizontalScrollBarVisibility="Auto" DragDrop.AllowDrop="True">
                    <ListBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding Remote.OpenCommand}" CommandParameter="{Binding #RemoteList.SelectedItem}" />
                        <KeyBinding Gesture="Back" Command="{Binding Remote.UpCommand}" />
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                        <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
                    </ListBox.KeyBindings>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static app:UiText.Download}" Command="{Binding DownloadCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static app:UiText.NewFolder}" Command="{Binding NewFolderCommand}" />
                            <MenuItem Header="{x:Static app:UiText.Rename}" Command="{Binding RenameCommand}" InputGesture="F2" />
                            <MenuItem Header="{x:Static app:UiText.Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete" />
                            <Separator />
                            <MenuItem Header="{x:Static app:UiText.Refresh}" Command="{Binding Remote.ReloadCommand}" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                </ListBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
