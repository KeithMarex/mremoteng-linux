<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:app="using:mRemoteNG.Avalonia"
             xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
             x:Class="mRemoteNG.Avalonia.Views.PropertyGridView"
             x:DataType="vm:PropertyPanelViewModel">
    <!-- Windows mRemoteNG's Config panel: a WinForms property grid with its toolbar and help area. -->
    <UserControl.Styles>
        <Style Selector="ToggleButton.category">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="19" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource MrGridCategory}" />
            <Setter Property="Foreground" Value="{DynamicResource MrForeground}" />
        </Style>
        <Style Selector="ToggleButton.category:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.category:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.category:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource MrGridCategory}" />
            <Setter Property="Foreground" Value="{DynamicResource MrForeground}" />
        </Style>
        <!-- The grid's boxed +/- before each category, as the tree's. -->
        <Style Selector="Border.expander">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="Background" Value="{DynamicResource MrTextBoxBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource MrExpanderBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.expander Rectangle">
            <Setter Property="Fill" Value="{DynamicResource MrExpanderGlyph}" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="BorderBrush" Value="{DynamicResource MrGridLine}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="{DynamicResource MrPanelBackground}" />
        </Style>
        <Style Selector="Border.row TextBlock.name">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.row.selected Border.name">
            <Setter Property="Background" Value="{DynamicResource MrSelection}" />
        </Style>
        <Style Selector="Border.row.selected TextBlock.name">
            <Setter Property="Foreground" Value="{DynamicResource MrSelectionForeground}" />
        </Style>
        <!-- Values are edited in place, without the editors' chrome. -->
        <!-- Rows as compact as the WinForms grid's. -->
        <Style Selector="TextBox.cell">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ComboBox.cell">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="TextBox.cell /template/ Border#PART_BorderElement, TextBox.cell:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.cell:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="{DynamicResource MrTextBoxBackground}" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="ComboBox.cell /template/ Border#Background, ComboBox.cell:pointerover /template/ Border#Background, ComboBox.cell:focus /template/ Border#Background">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TextBox.cell.modified, ComboBox.cell.modified">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="toolbar">
            <StackPanel Orientation="Horizontal">
                <Button Classes.checked="{Binding IsCategorized}" Command="{Binding ShowCategorizedCommand}"
                        ToolTip.Tip="{x:Static app:UiText.Categorized}">
                    <!-- No image of Windows' own: its property grid draws this icon itself. -->
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="1" Canvas.Top="2" Width="4" Height="4" Fill="{DynamicResource MrAccent}" />
                        <Rectangle Canvas.Left="7" Canvas.Top="3" Width="8" Height="1" Fill="{DynamicResource MrForeground}" />
                        <Rectangle Canvas.Left="7" Canvas.Top="6" Width="8" Height="1" Fill="{DynamicResource MrForeground}" />
                        <Rectangle Canvas.Left="1" Canvas.Top="9" Width="4" Height="4" Fill="{DynamicResource MrAccent}" />
                        <Rectangle Canvas.Left="7" Canvas.Top="10" Width="8" Height="1" Fill="{DynamicResource MrForeground}" />
                        <Rectangle Canvas.Left="7" Canvas.Top="13" Width="8" Height="1" Fill="{DynamicResource MrForeground}" />
                    </Canvas>
                </Button>
                <Button Classes.checked="{Binding IsAlphabetical}" Command="{Binding ShowAlphabeticalCommand}"
                        ToolTip.Tip="{x:Static app:UiText.Alphabetical}">
                    <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/SortAscending_16x.png" />
                </Button>
                <Rectangle Classes="separator" />
                <Button Classes.checked="{Binding IsPropertiesView}" Command="{Binding ShowPropertiesCommand}"
                        ToolTip.Tip="{x:Static app:UiText.PropertiesView}">
                    <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Property_16x.png" />
                </Button>
                <Button Classes.checked="{Binding IsInheritanceView}" Command="{Binding ShowInheritanceCommand}"
                        ToolTip.Tip="{x:Static app:UiText.InheritanceView}">
                    <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Schema_16x.png" />
                </Button>
            </StackPanel>
        </Border>

        <!-- The selected property's help, as under Windows' grid -->
        <Border DockPanel.Dock="Bottom" Height="62" Margin="0,3,0,0" Padding="5,3" IsVisible="{Binding IsDescriptionVisible}"
                Background="{DynamicResource MrTextBoxBackground}" BorderBrush="{DynamicResource MrPanelBorder}" BorderThickness="1">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding DescriptionTitle}" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding DescriptionText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border BorderBrush="{DynamicResource MrPanelBorder}" BorderThickness="1" Background="{DynamicResource MrPanelBackground}">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PropertyGroupViewModel">
                            <StackPanel>
                                <ToggleButton Classes="category" IsVisible="{Binding ShowHeader}" IsChecked="{Binding IsExpanded}">
                                    <Grid ColumnDefinitions="16,*">
                                        <Border Classes="expander">
                                            <Panel>
                                                <Rectangle Width="5" Height="1" />
                                                <Rectangle Width="1" Height="5" IsVisible="{Binding !IsExpanded}" />
                                            </Panel>
                                        </Border>
                                        <TextBlock Grid.Column="1" Margin="4,0" Text="{Binding Category}" FontWeight="Bold"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </ToggleButton>
                                <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PropertyItemViewModel">
                                            <Border Classes="row" Classes.selected="{Binding IsSelected}">
                                                <Grid ColumnDefinitions="16,*,1,*" Height="18">
                                                    <Border Background="{DynamicResource MrGridCategory}" />
                                                    <Border Grid.Column="1" Classes="name">
                                                        <TextBlock Classes="name" Text="{Binding DisplayName}"
                                                                   ToolTip.Tip="{Binding DisplayName}" />
                                                    </Border>
                                                    <Border Grid.Column="2" Background="{DynamicResource MrGridLine}" />
                                                    <TextBox Grid.Column="3" Classes="cell" Classes.modified="{Binding IsModified}"
                                                             IsVisible="{Binding IsText}" IsReadOnly="{Binding !IsEditable}"
                                                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                                    <TextBox Grid.Column="3" Classes="cell" IsVisible="{Binding IsPassword}"
                                                             IsReadOnly="{Binding !IsEditable}" PasswordChar="•"
                                                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                                    <ComboBox Grid.Column="3" Classes="cell" Classes.modified="{Binding IsModified}"
                                                              IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsEditable}"
                                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</UserControl>
