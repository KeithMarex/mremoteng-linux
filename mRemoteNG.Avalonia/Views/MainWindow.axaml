<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:mRemoteNG.Avalonia"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:views="using:mRemoteNG.Avalonia.Views"
        x:Class="mRemoteNG.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://mRemoteNG.Avalonia/Assets/mremoteng.png"
        Width="1200" Height="800" MinWidth="700" MinHeight="450">
    <Window.Styles>
        <Style Selector="TextBlock.panelHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,6" />
        </Style>
        <Style Selector="TextBlock.connected">
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style Selector="TextBlock.ended">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="TabStripItem">
            <Setter Property="FontSize" Value="{DynamicResource ControlContentThemeFontSize}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="10,2" />
        </Style>
        <Style Selector="Button.closeTab">
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="{x:Static app:UiText.File}">
                <MenuItem Header="{x:Static app:UiText.NewConnectionFile}" Command="{Binding NewFileCommand}" InputGesture="Ctrl+N" />
                <MenuItem Header="{x:Static app:UiText.OpenConnectionFile}" Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O" />
                <MenuItem Header="{x:Static app:UiText.SaveConnectionFile}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" />
                <MenuItem Header="{x:Static app:UiText.SaveConnectionFileAs}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.ImportFromFile}" Command="{Binding ImportCommand}" InputGesture="Ctrl+I" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.Exit}" Click="OnExitClick" InputGesture="Ctrl+Q" />
            </MenuItem>
            <MenuItem Header="{x:Static app:UiText.Tools}">
                <MenuItem Header="{x:Static app:UiText.Options}" Command="{Binding OpenOptionsCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static app:UiText.Edit}">
                <MenuItem Header="{x:Static app:UiText.NewConnection}" Command="{Binding AddConnectionCommand}" InputGesture="Ctrl+Shift+N" />
                <MenuItem Header="{x:Static app:UiText.NewFolder}" Command="{Binding AddFolderCommand}" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.Duplicate}" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D" />
                <MenuItem Header="{x:Static app:UiText.Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.MoveUp}" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up" />
                <MenuItem Header="{x:Static app:UiText.MoveDown}" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down" />
            </MenuItem>
        </Menu>

        <!-- Notifications -->
        <Border DockPanel.Dock="Bottom" Height="140" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{x:Static app:UiText.Notifications}" />
                <ListBox ItemsSource="{Binding Messages.Items}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageItem">
                            <Grid ColumnDefinitions="70,70,*">
                                <TextBlock Text="{Binding Time}" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="420,4,*">
            <Grid RowDefinitions="Auto,Auto,*,4,Auto,*">
                <TextBlock Classes="panelHeader" Text="{x:Static app:UiText.Connections}" />
                <TextBox Grid.Row="1" Margin="8,0,8,4" PlaceholderText="{x:Static app:UiText.Search}"
                         Text="{Binding SearchText}" />
                <TreeView Grid.Row="2" x:Name="ConnectionTree" ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode}"
                          DragDrop.AllowDrop="True">
                    <TreeView.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                        <KeyBinding Gesture="Enter" Command="{Binding ConnectCommand}" />
                    </TreeView.KeyBindings>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:ConnectionNodeViewModel">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static app:UiText.Connect}" Command="{Binding ConnectCommand}" InputGesture="Enter" />
                            <MenuItem Header="{x:Static app:UiText.OpenFileTransfer}" Command="{Binding OpenFileTransferCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static app:UiText.NewConnection}" Command="{Binding AddConnectionCommand}" />
                            <MenuItem Header="{x:Static app:UiText.NewFolder}" Command="{Binding AddFolderCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static app:UiText.Duplicate}" Command="{Binding DuplicateCommand}" />
                            <MenuItem Header="{x:Static app:UiText.Delete}" Command="{Binding DeleteCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static app:UiText.MoveUp}" Command="{Binding MoveUpCommand}" />
                            <MenuItem Header="{x:Static app:UiText.MoveDown}" Command="{Binding MoveDownCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:ConnectionNodeViewModel" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" Classes.connected="{Binding IsConnected}" />
                                <TextBlock Text="{Binding Detail}" Opacity="0.55" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Row="3" ResizeDirection="Rows" />

                <TextBlock Grid.Row="4" Classes="panelHeader" Text="{x:Static app:UiText.Properties}" />
                <ScrollViewer Grid.Row="5" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PropertyPanel.Groups}" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PropertyGroupViewModel">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PropertyItemViewModel">
                                                <Grid ColumnDefinitions="160,*,Auto" Margin="0,2" ToolTip.Tip="{Binding Description}">
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBox Grid.Column="1" IsVisible="{Binding IsText}" IsEnabled="{Binding IsEditable}"
                                                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                                    <TextBox Grid.Column="1" IsVisible="{Binding IsPassword}" IsEnabled="{Binding IsEditable}"
                                                             PasswordChar="•" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                                    <CheckBox Grid.Column="1" IsVisible="{Binding IsBoolean}" IsEnabled="{Binding IsEditable}"
                                                              IsChecked="{Binding BooleanValue}" />
                                                    <ComboBox Grid.Column="1" IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsEditable}"
                                                              HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" />
                                                    <CheckBox Grid.Column="2" Margin="8,0,0,0" IsVisible="{Binding CanInherit}"
                                                              IsChecked="{Binding IsInherited}" Content="{x:Static app:UiText.Inherit}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- Sessions -->
            <DockPanel Grid.Column="2">
                <TabStrip DockPanel.Dock="Top" ItemsSource="{Binding Sessions.Items}" SelectedItem="{Binding Sessions.Selected}"
                          IsVisible="{Binding Sessions.HasSessions}">
                    <TabStrip.ItemTemplate>
                        <DataTemplate x:DataType="vm:SessionTabViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="4" CornerRadius="2" Background="{Binding TabBrush}"
                                        IsVisible="{Binding TabBrush, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Classes.ended="{Binding HasEnded}" />
                                <Button Classes="closeTab" Content="✕" Command="{Binding CloseCommand}"
                                        ToolTip.Tip="{x:Static app:UiText.CloseTab}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </TabStrip.ItemTemplate>
                </TabStrip>
                <Panel>
                    <TextBlock Text="{x:Static app:UiText.NoSessionsYet}" TextWrapping="Wrap" Opacity="0.6"
                               IsVisible="{Binding !Sessions.HasSessions}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center" />
                    <!-- Every session stays in the visual tree, so its terminal keeps running; only the selected one shows. -->
                    <ItemsControl ItemsSource="{Binding Sessions.Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Panel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:SessionViewModel">
                                <views:SessionView IsVisible="{Binding IsSelected}" />
                            </DataTemplate>
                            <DataTemplate DataType="vm:FileTransferViewModel">
                                <views:FileTransferView IsVisible="{Binding IsSelected}" />
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </Panel>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
