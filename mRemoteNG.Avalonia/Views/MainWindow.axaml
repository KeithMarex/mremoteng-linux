<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:mRemoteNG.Avalonia"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        xmlns:views="using:mRemoteNG.Avalonia.Views"
        x:Class="mRemoteNG.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://mRemoteNG.Avalonia/Assets/mremoteng.png"
        Background="{DynamicResource MrEnvironmentBackground}"
        Width="1200" Height="800" MinWidth="700" MinHeight="450">
    <Window.Styles>
        <Style Selector="TextBlock.ended">
            <Setter Property="Opacity" Value="0.6" />
        </Style>
        <Style Selector="Button.closeTab">
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{Binding $parent[TabStripItem].Foreground}" />
        </Style>
        <!-- The close glyph keeps the tab's text colour, white on the selected tab. -->
        <Style Selector="Button.closeTab:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.closeTab:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#40FFFFFF" />
            <Setter Property="Foreground" Value="{Binding $parent[TabStripItem].Foreground}" />
        </Style>
        <!-- As on Windows, a connection's tab colour is the background of its selected tab. -->
        <Style Selector="TabStrip.documents TabStripItem:selected /template/ Border#PART_LayoutRoot" x:DataType="vm:SessionTabViewModel">
            <Setter Property="Background" Value="{Binding TabBrush, TargetNullValue={StaticResource MrAccentStatic}}" />
        </Style>
        <Style Selector="MenuItem Image">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu x:Name="MainMenu" DockPanel.Dock="Top">
            <MenuItem Header="{x:Static app:UiText.File}">
                <MenuItem Header="{x:Static app:UiText.NewConnectionFile}" Command="{Binding NewFileCommand}" InputGesture="Ctrl+N">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/NewFile_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static app:UiText.OpenConnectionFile}" Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/OpenFile_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static app:UiText.SaveConnectionFile}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Save_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static app:UiText.SaveConnectionFileAs}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.ImportFromFile}" Command="{Binding ImportCommand}" InputGesture="Ctrl+I" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.Exit}" Click="OnExitClick" InputGesture="Ctrl+Q">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/CloseSolution_16x.png" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static app:UiText.Edit}">
                <MenuItem Header="{x:Static app:UiText.NewConnection}" Command="{Binding AddConnectionCommand}" InputGesture="Ctrl+Shift+N">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/AddItem_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static app:UiText.NewFolder}" Command="{Binding AddFolderCommand}">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/AddFolder_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static app:UiText.Duplicate}" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Copy_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static app:UiText.Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Close_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <Separator />
                <MenuItem Header="{x:Static app:UiText.MoveUp}" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/GlyphUp_16x.png" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="{x:Static app:UiText.MoveDown}" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/GlyphDown_16x.png" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="{x:Static app:UiText.View}">
                <MenuItem Header="{x:Static app:UiText.Notifications}" ToggleType="CheckBox"
                          IsChecked="{Binding IsNotificationsVisible, Mode=TwoWay}" />
                <MenuItem Header="{x:Static app:UiText.PropertyDescription}" ToggleType="CheckBox"
                          IsChecked="{Binding IsPropertyDescriptionVisible, Mode=TwoWay}" />
            </MenuItem>
            <MenuItem Header="{x:Static app:UiText.Tools}">
                <MenuItem Header="{x:Static app:UiText.Options}" Command="{Binding OpenOptionsCommand}">
                    <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Settings_16x.png" /></MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- The last row is the Notifications panel; the code-behind folds it away while the panel is hidden. -->
        <Grid x:Name="LayoutGrid" RowDefinitions="*,3,150" Margin="3,0,3,3">
            <Grid ColumnDefinitions="340,3,*">
                <Grid RowDefinitions="*,3,*">
                    <!-- Connections -->
                    <Border Classes="toolPanel">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="caption">
                                <DockPanel>
                                    <TextBlock Text="{x:Static app:UiText.Connections}" />
                                    <Rectangle Classes="grip" />
                                </DockPanel>
                            </Border>
                            <Border DockPanel.Dock="Top" Classes="toolbar">
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding AddConnectionCommand}" ToolTip.Tip="{x:Static app:UiText.NewConnection}">
                                        <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/AddItem_16x.png" />
                                    </Button>
                                    <Button Command="{Binding AddFolderCommand}" ToolTip.Tip="{x:Static app:UiText.NewFolder}">
                                        <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/AddFolder_16x.png" />
                                    </Button>
                                    <Button Command="{Binding ExpandAllCommand}" ToolTip.Tip="{x:Static app:UiText.ExpandAllFolders}">
                                        <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/ExpandAll_16x.png" />
                                    </Button>
                                    <Button Command="{Binding CollapseAllCommand}" ToolTip.Tip="{x:Static app:UiText.CollapseAllFolders}">
                                        <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/CollapseAll_16x.png" />
                                    </Button>
                                    <Button x:Name="SortButton" Command="{Binding SortCommand}" ToolTip.Tip="{x:Static app:UiText.Sort}">
                                        <Panel>
                                            <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/SortAscending_16x.png"
                                                   IsVisible="{Binding IsNextSortAscending}" />
                                            <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/SortDescending_16x.png"
                                                   IsVisible="{Binding !IsNextSortAscending}" />
                                        </Panel>
                                    </Button>
                                    <Button x:Name="FavoritesButton" Click="OnFavoritesClick" ToolTip.Tip="{x:Static app:UiText.Favorites}">
                                        <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Favorite_16x.png" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <!-- Search, at the bottom as in Windows' default layout -->
                            <TextBox DockPanel.Dock="Bottom" Margin="0" BorderThickness="0,1,0,0" PlaceholderText="{x:Static app:UiText.Search}"
                                     Text="{Binding SearchText}">
                                <TextBox.InnerLeftContent>
                                    <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Search_16x.png" Width="16" Height="16" Margin="4,0,0,0" />
                                </TextBox.InnerLeftContent>
                            </TextBox>
                            <TreeView x:Name="ConnectionTree" Classes="connections" ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode}"
                                      DragDrop.AllowDrop="True">
                                <TreeView.KeyBindings>
                                    <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                                    <KeyBinding Gesture="Enter" Command="{Binding ConnectCommand}" />
                                </TreeView.KeyBindings>
                                <TreeView.Styles>
                                    <Style Selector="TreeViewItem" x:DataType="vm:ConnectionNodeViewModel">
                                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                        <Setter Property="IsVisible" Value="{Binding IsVisible}" />
                                    </Style>
                                </TreeView.Styles>
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{x:Static app:UiText.Connect}" Command="{Binding ConnectCommand}" InputGesture="Enter">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Run_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static app:UiText.OpenFileTransfer}" Command="{Binding OpenFileTransferCommand}">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/SyncArrow_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static app:UiText.Duplicate}" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Copy_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static app:UiText.Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/Close_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static app:UiText.NewConnection}" Command="{Binding AddConnectionCommand}">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/AddItem_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static app:UiText.NewFolder}" Command="{Binding AddFolderCommand}">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/AddFolder_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                        <Separator />
                                        <MenuItem Header="{x:Static app:UiText.MoveUp}" Command="{Binding MoveUpCommand}" InputGesture="Alt+Up">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/GlyphUp_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="{x:Static app:UiText.MoveDown}" Command="{Binding MoveDownCommand}" InputGesture="Alt+Down">
                                            <MenuItem.Icon><Image Source="avares://mRemoteNG.Avalonia/Assets/Images/GlyphDown_16x.png" /></MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemTemplate>
                                    <TreeDataTemplate x:DataType="vm:ConnectionNodeViewModel" ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" ToolTip.Tip="{Binding ToolTip}">
                                            <Panel Width="16" Height="16">
                                                <Image Source="{Binding Icon}" />
                                                <!-- Windows' "connected" overlay -->
                                                <Image Source="avares://mRemoteNG.Avalonia/Assets/Images/ConnectedOverlay.png" IsVisible="{Binding IsConnected}"
                                                       Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" />
                                            </Panel>
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </TreeDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" />

                    <!-- Config -->
                    <Border Grid.Row="2" Classes="toolPanel">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Classes="caption">
                                <DockPanel>
                                    <TextBlock Text="{x:Static app:UiText.Config}" />
                                    <Rectangle Classes="grip" />
                                </DockPanel>
                            </Border>
                            <views:PropertyGridView DataContext="{Binding PropertyPanel}" />
                        </DockPanel>
                    </Border>
                </Grid>

                <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="Transparent" />

                <!-- Sessions -->
                <DockPanel Grid.Column="2">
                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource MrAccent}" BorderThickness="0,0,0,2"
                            IsVisible="{Binding Sessions.HasSessions}">
                        <TabStrip Classes="documents" ItemsSource="{Binding Sessions.Items}" SelectedItem="{Binding Sessions.Selected}">
                            <TabStrip.ItemTemplate>
                                <DataTemplate x:DataType="vm:SessionTabViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <Image Source="{Binding Icon}" Width="16" Height="16" />
                                        <TextBlock Text="{Binding Title}" VerticalAlignment="Center" Classes.ended="{Binding HasEnded}" />
                                        <Button Classes="closeTab" Content="✕" Command="{Binding CloseCommand}"
                                                ToolTip.Tip="{x:Static app:UiText.CloseTab}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </TabStrip.ItemTemplate>
                        </TabStrip>
                    </Border>
                    <Panel>
                        <TextBlock Text="{x:Static app:UiText.NoSessionsYet}" TextWrapping="Wrap" Opacity="0.6"
                                   IsVisible="{Binding !Sessions.HasSessions}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center" />
                        <!-- Every session stays in the visual tree, so its terminal keeps running; only the selected one shows. -->
                        <ItemsControl ItemsSource="{Binding Sessions.Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Panel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:SessionViewModel">
                                    <views:SessionView IsVisible="{Binding IsSelected}" />
                                </DataTemplate>
                                <DataTemplate DataType="vm:FileTransferViewModel">
                                    <views:FileTransferView IsVisible="{Binding IsSelected}" />
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </Panel>
                </DockPanel>
            </Grid>

            <GridSplitter Grid.Row="1" ResizeDirection="Rows" Background="Transparent" IsVisible="{Binding IsNotificationsVisible}" />

            <!-- Notifications -->
            <Border Grid.Row="2" Classes="toolPanel" IsVisible="{Binding IsNotificationsVisible}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Classes="caption">
                        <DockPanel>
                            <TextBlock Text="{x:Static app:UiText.Notifications}" />
                            <Rectangle Classes="grip" />
                        </DockPanel>
                    </Border>
                    <views:NotificationsView DataContext="{Binding Messages}" />
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
