<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:mRemoteNG.Avalonia"
        xmlns:vm="using:mRemoteNG.Avalonia.ViewModels"
        x:Class="mRemoteNG.Avalonia.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1200" Height="800" MinWidth="700" MinHeight="450">
    <Window.Styles>
        <Style Selector="TextBlock.panelHeader">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,6" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static app:UiText.File}">
                <MenuItem Header="{x:Static app:UiText.NewConnectionFile}" Command="{Binding NewFileCommand}" InputGesture="Ctrl+N" HotKey="Ctrl+N" />
                <MenuItem Header="{x:Static app:UiText.OpenConnectionFile}" Command="{Binding OpenFileCommand}" InputGesture="Ctrl+O" HotKey="Ctrl+O" />
                <MenuItem Header="{x:Static app:UiText.SaveConnectionFile}" Command="{Binding SaveCommand}" InputGesture="Ctrl+S" HotKey="Ctrl+S" />
                <MenuItem Header="{x:Static app:UiText.SaveConnectionFileAs}" Command="{Binding SaveAsCommand}" InputGesture="Ctrl+Shift+S" HotKey="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.Exit}" Click="OnExitClick" InputGesture="Ctrl+Q" HotKey="Ctrl+Q" />
            </MenuItem>
            <MenuItem Header="{x:Static app:UiText.Edit}">
                <MenuItem Header="{x:Static app:UiText.NewConnection}" Command="{Binding AddConnectionCommand}" InputGesture="Ctrl+Shift+N" HotKey="Ctrl+Shift+N" />
                <MenuItem Header="{x:Static app:UiText.NewFolder}" Command="{Binding AddFolderCommand}" />
                <Separator />
                <MenuItem Header="{x:Static app:UiText.Duplicate}" Command="{Binding DuplicateCommand}" InputGesture="Ctrl+D" HotKey="Ctrl+D" />
                <MenuItem Header="{x:Static app:UiText.Delete}" Command="{Binding DeleteCommand}" InputGesture="Delete" />
            </MenuItem>
        </Menu>

        <!-- Notifications -->
        <Border DockPanel.Dock="Bottom" Height="140" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Classes="panelHeader" Text="{x:Static app:UiText.Notifications}" />
                <ListBox ItemsSource="{Binding Messages.Items}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MessageItem">
                            <Grid ColumnDefinitions="70,70,*">
                                <TextBlock Text="{Binding Time}" Opacity="0.7" />
                                <TextBlock Grid.Column="1" Text="{Binding Level}" />
                                <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid ColumnDefinitions="420,4,*">
            <Grid RowDefinitions="Auto,*,4,Auto,*">
                <TextBlock Classes="panelHeader" Text="{x:Static app:UiText.Connections}" />
                <TreeView Grid.Row="1" x:Name="ConnectionTree" ItemsSource="{Binding RootNodes}" SelectedItem="{Binding SelectedNode}">
                    <TreeView.KeyBindings>
                        <KeyBinding Gesture="Delete" Command="{Binding DeleteCommand}" />
                    </TreeView.KeyBindings>
                    <TreeView.Styles>
                        <Style Selector="TreeViewItem" x:DataType="vm:ConnectionNodeViewModel">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        </Style>
                    </TreeView.Styles>
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{x:Static app:UiText.NewConnection}" Command="{Binding AddConnectionCommand}" />
                            <MenuItem Header="{x:Static app:UiText.NewFolder}" Command="{Binding AddFolderCommand}" />
                            <Separator />
                            <MenuItem Header="{x:Static app:UiText.Duplicate}" Command="{Binding DuplicateCommand}" />
                            <MenuItem Header="{x:Static app:UiText.Delete}" Command="{Binding DeleteCommand}" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.ItemTemplate>
                        <TreeDataTemplate x:DataType="vm:ConnectionNodeViewModel" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding Detail}" Opacity="0.55" />
                            </StackPanel>
                        </TreeDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <GridSplitter Grid.Row="2" ResizeDirection="Rows" />

                <TextBlock Grid.Row="3" Classes="panelHeader" Text="{x:Static app:UiText.Properties}" />
                <ScrollViewer Grid.Row="4" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding PropertyPanel.Groups}" Margin="8,0,8,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PropertyGroupViewModel">
                                <StackPanel Margin="0,6,0,0">
                                    <TextBlock Text="{Binding Category}" FontWeight="SemiBold" Opacity="0.8" Margin="0,0,0,4" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:PropertyItemViewModel">
                                                <Grid ColumnDefinitions="160,*,Auto" Margin="0,2" ToolTip.Tip="{Binding Description}">
                                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                    <TextBox Grid.Column="1" IsVisible="{Binding IsText}" IsEnabled="{Binding IsEditable}"
                                                             Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                                    <TextBox Grid.Column="1" IsVisible="{Binding IsPassword}" IsEnabled="{Binding IsEditable}"
                                                             PasswordChar="•" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                                    <CheckBox Grid.Column="1" IsVisible="{Binding IsBoolean}" IsEnabled="{Binding IsEditable}"
                                                              IsChecked="{Binding BooleanValue}" />
                                                    <ComboBox Grid.Column="1" IsVisible="{Binding IsChoice}" IsEnabled="{Binding IsEditable}"
                                                              HorizontalAlignment="Stretch"
                                                              ItemsSource="{Binding Choices}" SelectedItem="{Binding SelectedChoice}" />
                                                    <CheckBox Grid.Column="2" Margin="8,0,0,0" IsVisible="{Binding CanInherit}"
                                                              IsChecked="{Binding IsInherited}" Content="{x:Static app:UiText.Inherit}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <!-- Sessions (phase 3) -->
            <Border Grid.Column="2">
                <TextBlock Text="{x:Static app:UiText.NoSessionsYet}" TextWrapping="Wrap" Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" TextAlignment="Center" />
            </Border>
        </Grid>
    </DockPanel>
</Window>
