<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="using:mRemoteNG.Avalonia"
        x:Class="mRemoteNG.Avalonia.Views.PasswordDialog"
        Title="{x:Static app:UiText.Password}"
        Width="400" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="16" Spacing="10">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" />
        <TextBox x:Name="PasswordBox" PasswordChar="•" />
        <TextBox x:Name="ConfirmBox" PasswordChar="•" IsVisible="False"
                 PlaceholderText="{x:Static app:UiText.ConfirmPassword}" />
        <TextBlock x:Name="ErrorText" Foreground="#C42B1C" IsVisible="False" TextWrapping="Wrap"
                   Text="{x:Static app:UiText.PasswordsDoNotMatch}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{x:Static app:UiText.Ok}" IsDefault="True" Click="OnOkClick" MinWidth="80" />
            <Button Content="{x:Static app:UiText.Cancel}" IsCancel="True" Click="OnCancelClick" MinWidth="80" />
        </StackPanel>
    </StackPanel>
</Window>
